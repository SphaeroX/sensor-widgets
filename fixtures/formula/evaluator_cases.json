{
  "valid_cases": [
    {
      "name": "simple_addition",
      "formula": "A + B",
      "variables": { "A": 10.0, "B": 25.5 },
      "expected": 35.5
    },
    {
      "name": "simple_subtraction",
      "formula": "A - B",
      "variables": { "A": 50.0, "B": 20.25 },
      "expected": 29.75
    },
    {
      "name": "multiplication_and_division",
      "formula": "A * B / C",
      "variables": { "A": 10.0, "B": 6.0, "C": 4.0 },
      "expected": 15.0
    },
    {
      "name": "operator_precedence",
      "formula": "A + B * C",
      "variables": { "A": 2.0, "B": 3.0, "C": 4.0 },
      "expected": 14.0
    },
    {
      "name": "parentheses",
      "formula": "(A + B) * C",
      "variables": { "A": 2.0, "B": 3.0, "C": 4.0 },
      "expected": 20.0
    },
    {
      "name": "three_values_average",
      "formula": "(A + B + C) / 3",
      "variables": { "A": 20.0, "B": 22.0, "C": 24.0 },
      "expected": 22.0
    },
    {
      "name": "unary_minus",
      "formula": "-A + 10",
      "variables": { "A": 4.5 },
      "expected": 5.5
    },
    {
      "name": "unary_minus_inside_parentheses",
      "formula": "A * (-B)",
      "variables": { "A": 5.0, "B": 3.0 },
      "expected": -15.0
    },
    {
      "name": "decimal_constants",
      "formula": "A * 1.8 + 32.0",
      "variables": { "A": 25.0 },
      "expected": 77.0
    },
    {
      "name": "multi_character_identifiers",
      "formula": "temp_in - temp_out",
      "variables": { "temp_in": 24.5, "temp_out": 14.0 },
      "expected": 10.5
    }
  ],
  "error_cases": [
    {
      "name": "division_by_zero",
      "formula": "A / B",
      "variables": { "A": 10.0, "B": 0.0 },
      "expected_error": "division_by_zero"
    },
    {
      "name": "syntax_error_unclosed_parenthesis",
      "formula": "(A + B",
      "variables": { "A": 1.0, "B": 2.0 },
      "expected_error": "syntax_error"
    },
    {
      "name": "syntax_error_consecutive_operators",
      "formula": "A ++ B",
      "variables": { "A": 1.0, "B": 2.0 },
      "expected_error": "syntax_error"
    },
    {
      "name": "missing_variable",
      "formula": "A + B",
      "variables": { "A": 1.0 },
      "expected_error": "missing_variable"
    }
  ]
}
