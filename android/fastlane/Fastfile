# Runs in GitHub Actions only (.github/workflows/play-internal.yml).
# Needs PLAY_SERVICE_ACCOUNT_JSON and a prepared android/key.properties.
default_platform(:android)

PLAY_TRACKS = %w[internal alpha beta production].freeze

platform :android do
  desc "Build a signed AAB and upload it to a Play testing track. " \
       "Options: track (default internal), release_status (completed or draft)"
  lane :internal do |options|
    track = options[:track] || "internal"
    release_status = options[:release_status] || "completed"
    json_key = ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON")
    root = sh("git", "rev-parse", "--show-toplevel", log: false).strip

    # Every upload needs a versionCode above all codes Play has seen.
    codes = PLAY_TRACKS.flat_map do |name|
      google_play_track_version_codes(track: name, json_key_data: json_key)
    rescue StandardError => e
      UI.important("No version codes for track #{name}: #{e.message}")
      []
    end
    version_code = (codes + [0]).max + 1
    UI.message("Next versionCode: #{version_code}")

    Dir.chdir(root) do
      sh("flutter", "build", "appbundle", "--release", "--build-number=#{version_code}")
    end
    aab = File.join(root, "build/app/outputs/bundle/release/app-release.aab")
    # R8 deobfuscation file, so Play shows readable crash stack traces.
    mapping = File.join(root, "build/app/outputs/mapping/release/mapping.txt")

    Dir.chdir(root) do
      sh("dart", "run", "tool/verify_release_signing.dart", aab, "android/upload-cert.sha256")
    end

    upload_to_play_store(
      json_key_data: json_key,
      track: track,
      release_status: release_status,
      aab: aab,
      mapping: mapping,
      skip_upload_apk: true,
      skip_upload_metadata: true,
      skip_upload_changelogs: true,
      skip_upload_images: true,
      skip_upload_screenshots: true
    )
  end
end
